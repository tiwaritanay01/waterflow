# ===========================================================================
# WATERFLOW OS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env and customize for local or staging deployment.
# NEVER COMMIT ACTIVE SECRETS OR PRODUCTION PASSWORDS TO GIT.
# ===========================================================================

# Environment Mode
NODE_ENV=production
ENVIRONMENT=staging
LOG_LEVEL=info

# Gateway API Configuration (Node.js / Express)
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI / Optimization Engine (FastAPI)
AI_ENGINE_URL=http://ai_engine:8000
AI_ENGINE_PORT=8000

# PostgreSQL / PostGIS Database Configuration
PGHOST=postgres
PGPORT=5432
PGDATABASE=waterflow_os
PGUSER=waterflow_admin
PGPASSWORD=replace_with_secure_random_password_in_production

# Frontend Static Assets & Vite Server
VITE_API_URL=http://localhost:3001
VITE_AI_URL=http://localhost:8000

# Security & Session Secrets
SESSION_SECRET=replace_with_32_byte_hex_secret
JWT_SECRET=replace_with_32_byte_jwt_secret
